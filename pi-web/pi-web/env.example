# Copy to ~/.config/pi-web/env and chmod 600. Do not commit the real file.
# Generate a password: openssl rand -base64 24 | tr -d '/+='
PI_WEB_PASSWORD='change-me'
# Tailscale MagicDNS names for this machine (short and full), comma-separated.
PI_WEB_ALLOWED_HOSTS='my-host,my-host.tailXXXX.ts.net'
PI_WEB_NO_OPEN=1
