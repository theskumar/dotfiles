# Copy to ~/.config/pi-pocket/env and chmod 600. Do not commit the real file.
# Access mode: local, lan (all interfaces), tailscale (tailnet address only), cloudflare.
PI_POCKET_ACCESS=lan
PI_POCKET_PORT=30142
# Source checkout, if not ~/code/pi-pocket.
# PI_POCKET_SRC="$HOME/code/pi-pocket"
# Turn off Lancet Guard.
# PI_POCKET_GUARD=off
# Node preload for the Claude bridge provider. Set to a missing path to skip it.
# PI_POCKET_PRELOAD="$HOME/code/pi-claude-bridge/src/pocket-preload.ts"
